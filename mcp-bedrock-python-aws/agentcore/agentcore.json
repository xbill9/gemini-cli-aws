{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "McpBedrockPythonAws",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:project-name": "McpBedrockPythonAws"
  },
  "runtimes": [
    {
      "name": "test-agent",
      "build": "CodeZip",
      "entrypoint": "agent.py",
      "codeLocation": "app/testagent/",
      "runtimeVersion": "PYTHON_3_12",
      "instrumentation": {
        "enableOtel": true
      }
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "hello-world-gateway",
      "targets": [
        {
          "name": "hello-world-target",
          "targetType": "mcpServer",
          "toolDefinitions": [
            {
              "name": "greet",
              "description": "Echo the input parameter.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "param": {
                    "type": "string"
                  }
                },
                "required": [
                  "param"
                ]
              }
            }
          ],
          "compute": {
            "host": "AgentCoreRuntime",
            "implementation": {
              "language": "Python",
              "path": "app/hello_world_server/server.py",
              "handler": "server:mcp"
            },
            "runtime": {
              "artifact": "CodeZip",
              "pythonVersion": "PYTHON_3_12",
              "name": "hello_world_server",
              "entrypoint": "server.py",
              "codeLocation": "app/hello_world_server/",
              "instrumentation": {
                "enableOtel": true
              }
            }
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": []
}