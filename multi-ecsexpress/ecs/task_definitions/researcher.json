{
    "executionRoleArn": "arn:aws:iam::106059658660:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::106059658660:role/ecsTaskExecutionRole",
    "family": "researcher",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "researcher",
            "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/researcher:latest",
            "portMappings": [
                {
                    "containerPort": 8000,
                    "hostPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "GOOGLE_API_KEY",
                    "value": "<GOOGLE_API_KEY>"
                },
                {
                    "name": "GENAI_MODEL",
                    "value": "gemini-2.5-flash"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/researcher",
                    "awslogs-region": "<REGION>",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}
